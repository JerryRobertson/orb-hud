<div class="orb-hud__bar">
  {{#each slots}}
  <div class="orb-hud__slot{{#unless filled}} orb-hud__slot--empty{{/unless}}{{#if broken}} orb-hud__slot--broken{{/if}}{{#if depleted}} orb-hud__slot--depleted{{/if}}" data-slot="{{index}}"
       {{#if tooltip}}data-tooltip="{{tooltip}}" data-tooltip-direction="{{../tooltipDir}}"{{/if}}{{#if filled}} draggable="true"{{/if}}>
    {{#if img}}<img src="{{img}}" alt="" draggable="false">{{/if}}
    {{#if broken}}<i class="fa-solid fa-triangle-exclamation"></i>{{/if}}
    {{#if key}}<span class="orb-hud__slot-key">{{key}}</span>{{/if}}
    {{#if badge}}<span class="orb-hud__slot-badge">{{badge}}</span>{{/if}}
  </div>
  {{/each}}
  {{#if showPager}}
  <div class="orb-hud__pager">
    <button type="button" data-page="-1" data-tooltip="{{localize 'ORBHUD.Bar.PageUp'}}" data-tooltip-direction="{{tooltipDir}}"><i class="fa-solid fa-chevron-up"></i></button>
    <span class="orb-hud__page">{{pageLabel}}</span>
    <button type="button" data-page="1" data-tooltip="{{localize 'ORBHUD.Bar.PageDown'}}" data-tooltip-direction="{{tooltipDir}}"><i class="fa-solid fa-chevron-down"></i></button>
  </div>
  {{/if}}
</div>
